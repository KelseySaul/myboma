# Client-safe values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_USE_GATEWAY=false
VITE_API_BASE_URL=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_APP_RELEASE=myboma@0.0.0
# Comma-separated emails bootstrapped as super admin on login (also set server-side)
VITE_SUPER_ADMIN_EMAILS=admin@gmail.com,sailkelsey@gmail.com

# Server
NODE_ENV=development
SERVER_PORT=3001
APP_BASE_URL=http://localhost:4173
# IMPORTANT: In production (Vercel), set this to your Vercel URL, e.g.:
# APP_BASE_URL=https://myboma.vercel.app
# CORS_ORIGINS=https://myboma.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated super admin emails (synced to DB on session)
SUPER_ADMIN_EMAILS=admin@gmail.com,sailkelsey@gmail.com
# Set true only for local dev gateway proxy to Supabase
ENABLE_SUPABASE_PROXY=false

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=kes

# Pesapal API 3.0
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_CURRENCY=KES
PESAPAL_COUNTRY_CODE=KE
PESAPAL_BRANCH=MyBoma
PESAPAL_CALLBACK_URL=https://your-domain.com/api/payments/pesapal/callback
PESAPAL_IPN_URL=https://your-domain.com/api/webhooks/pesapal/ipn
# Register PESAPAL_IPN_URL in Pesapal, then set the returned IPN ID here.
PESAPAL_NOTIFICATION_ID=your-pesapal-ipn-id
# Optional: if true, the server will register PESAPAL_IPN_URL when no matching IPN exists.
PESAPAL_AUTO_REGISTER_IPN=false
PESAPAL_IPN_METHOD=GET

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_BUSINESS_SHORTCODE=174379
MPESA_PASSKEY=your-stk-passkey
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-domain.com/api/webhooks/mpesa/stk
# Required in production — append ?secret=VALUE to callback URL or send header X-Mpesa-Callback-Secret
MPESA_CALLBACK_SECRET=your-long-random-secret

# Optional M-Pesa B2C landlord settlement after successful STK callback
MPESA_ENABLE_B2C_SETTLEMENT=false
MPESA_B2C_SHORTCODE=your-b2c-shortcode
MPESA_B2C_INITIATOR_NAME=your-initiator-name
MPESA_B2C_SECURITY_CREDENTIAL=your-encrypted-security-credential
MPESA_B2C_RESULT_URL=https://your-domain.com/api/webhooks/mpesa/b2c-result
MPESA_B2C_TIMEOUT_URL=https://your-domain.com/api/webhooks/mpesa/b2c-timeout
MPESA_B2C_COMMAND_ID=BusinessPayment

# Email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="MyBoma <no-reply@your-domain.com>"

# Server-side Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Neon Postgres (replacing Supabase DB) ---
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require
DIRECT_DATABASE_URL=postgresql://user:pass@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# --- Better-Auth (replacing Supabase Auth) ---
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 (replacing Supabase Storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=myboma-properties
R2_PUBLIC_URL=
